# ComfyUI 多磁盘模型路径配置示例
#
# 用途：主目录 models/ 在 SSD，冷模型放机械盘。把这个文件复制成
#       ComfyUI/extra_model_paths.yaml 后按实际情况改路径。
#
# 关键点：is_default 必须是 false。true 会让这条路径"接管"默认目录，
#        而不是追加 —— 那样 SSD 上的常用模型反而找不到了。

hdd_d:
    base_path: D:/AI-Models/models
    is_default: false

    checkpoints: checkpoints
    diffusion_models: |
        diffusion_models
        unet
    text_encoders: |
        text_encoders
        clip
    clip_vision: clip_vision
    vae: vae
    loras: loras
    controlnet: controlnet
    upscale_models: upscale_models
    embeddings: embeddings
    style_models: style_models
    model_patches: model_patches
